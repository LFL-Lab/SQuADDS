flowchart LR
    Q["Physical question<br/>What should an embedding preserve?"] --> C["Build paired controls<br/>same device, known change"]
    C --> N["Nuisance controls<br/>translate, rotate, reflect, crop"]
    C --> P["Physics controls<br/>scale, gap, facing length, moat"]
    N --> EN["Expected: vector stays fixed"]
    P --> EP["Expected: vector moves smoothly"]
    EN --> G["Predeclared pass/fail gates"]
    EP --> G
    G --> D["Only then ask whether<br/>capacitance prediction improves"]

    classDef question fill:#e8f1f8,stroke:#27689d,color:#172033;
    classDef nuisance fill:#f7e7e2,stroke:#d85832,color:#172033;
    classDef physics fill:#e5f1e8,stroke:#4a8f54,color:#172033;
    classDef gate fill:#eee7f4,stroke:#6f4c8b,color:#172033;
    class Q,C,D question;
    class N,EN nuisance;
    class P,EP physics;
    class G gate;
